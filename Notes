talosctl gen config Talos-Control-1 https://10.0.0.215:6443

talosctl -n 10.0.0.215 get disks --insecure --talosconfig=./talosconfig

update talosconfig for disk

talosctl apply-config --insecure -n 10.0.0.215 --file controlplane.yaml --talosconfig=./talosconfig

talosctl bootstrap --nodes 10.0.0.215 --endpoints 10.0.0.215 --talosconfig=./talosconfig

talosctl kubeconfig --nodes 10.0.0.215 --endpoints 10.0.0.215 \
  --talosconfig=./talosconfig

export KUBECONFIG=kubeconfig

add worker 

talosctl apply-config --insecure -n 10.0.0.28 --file worker.yaml


https://oneuptime.com/blog/post/2026-03-03-scale-up-a-talos-linux-cluster-by-adding-nodes/view


Test 

kubectl run test-pod --image=nginx --overrides='
{
  "spec": {
    "nodeName": "worker-01"
  }
}'